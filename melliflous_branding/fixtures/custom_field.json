  "read_only": 1,
  "module": "Melliflous Branding",
  "name": "Customer-custom_blocked_by"
 },
 {
  "doctype": "Custom Field",
  "dt": "Customer",
  "fieldname": "custom_blocked_on",
  "fieldtype": "Datetime",
  "label": "Blocked On",
