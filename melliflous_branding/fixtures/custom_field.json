  "module": "Melliflous Branding",
  "name": "Customer-custom_documents_tab"
 },
 {
  "doctype": "Custom Field",
  "dt": "Customer",
  "fieldname": "custom_customer_documents",
  "fieldtype": "Table",
  "label": "Documents",
  "options": "Customer Document",
